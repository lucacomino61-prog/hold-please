{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hold-please-brain",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Workers AI: the free caller brain (10,000 Neurons a day on the account, no key). Locally, wrangler dev runs the
  // binding against the real service, so `npm run brain` needs the Cloudflare login but no .dev.vars at all.
  "ai": { "binding": "AI" },
  "vars": {
    // Workers AI models callers are spread over, best first (scored on the game's prompt, scratchpad compare-models.mjs)
    "CF_MODELS": "@cf/openai/gpt-oss-20b,@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/openai/gpt-oss-120b",
    // every other Workers AI text model on the free allowance, used only when the preferred ones fail or rest (the ones that
    // need a paid billing method — kimi, glm-5.x, deepseek-v4 — are left out; a model that errors or says nothing rests an hour)
    "CF_MORE": "@cf/meta/llama-4-scout-17b-16e-instruct,@cf/mistralai/mistral-small-3.1-24b-instruct,@cf/meta/llama-3.1-70b-instruct-fp8-fast,@cf/qwen/qwen3.8-27b,@cf/nvidia/nemotron-3-120b-a12b,@cf/google/gemma-4-26b-a4b-it,@cf/aisingapore/gemma-sea-lion-v4-27b-it,@cf/qwen/qwen3-30b-a3b-fp8,@cf/zai-org/glm-4.7-flash,@cf/meta/llama-3.1-8b-instruct-fp8-fast,@cf/meta/llama-3.1-8b-instruct-fp8,@cf/meta/llama-3.1-8b-instruct-awq,@cf/meta/llama-3.1-8b-instruct,@cf/meta/llama-3-8b-instruct,@cf/meta/llama-3-8b-instruct-awq,@cf/meta/llama-3.2-11b-vision-instruct,@cf/meta/llama-3.2-3b-instruct,@cf/meta/llama-3.2-1b-instruct,@cf/mistral/mistral-7b-instruct-v0.1,@cf/ibm-granite/granite-4.0-h-micro,@cf/qwen/qwq-32b,@cf/deepseek-ai/deepseek-r1-distill-qwen-32b,@cf/daily-co/phonellm-mini-alpha-2",
    // keyed providers with free tiers: "models" are spread over callers, "more" are fallbacks. Each needs its key as a secret of
    // the given name: `npx wrangler secret put GROQ_API_KEY -c brain/wrangler.jsonc` (or a line in brain/.dev.vars locally).
    // A provider without its secret is skipped. Keys come from your own accounts: console.groq.com, aistudio.google.com,
    // openrouter.ai (free models: 50 requests a day, 1,000 after a one-time $10 top-up). Model ids change; a wrong one rests an hour.
    "CHAT_PROVIDERS": "[{\"name\":\"groq\",\"url\":\"https://api.groq.com/openai/v1/chat/completions\",\"models\":[\"openai/gpt-oss-20b\",\"openai/gpt-oss-120b\",\"llama-3.3-70b-versatile\"],\"more\":[\"meta-llama/llama-4-scout-17b-16e-instruct\",\"meta-llama/llama-4-maverick-17b-128e-instruct\",\"qwen/qwen3-32b\",\"moonshotai/kimi-k2-instruct\",\"llama-3.1-8b-instant\",\"gemma2-9b-it\"],\"secret\":\"GROQ_API_KEY\"},{\"name\":\"gemini\",\"url\":\"https://generativelanguage.googleapis.com/v1beta/openai/chat/completions\",\"models\":[\"gemini-2.5-flash-lite\",\"gemini-2.5-flash\"],\"more\":[\"gemini-2.0-flash\",\"gemini-2.0-flash-lite\",\"gemma-3-27b-it\",\"gemma-3-12b-it\"],\"secret\":\"GEMINI_API_KEY\"},{\"name\":\"openrouter\",\"url\":\"https://openrouter.ai/api/v1/chat/completions\",\"models\":[\"openai/gpt-oss-20b:free\",\"meta-llama/llama-3.3-70b-instruct:free\",\"google/gemma-3-27b-it:free\"],\"more\":[\"qwen/qwen3-235b-a22b:free\",\"deepseek/deepseek-chat-v3-0324:free\",\"mistralai/mistral-small-3.1-24b-instruct:free\",\"meta-llama/llama-4-maverick:free\",\"meta-llama/llama-4-scout:free\",\"google/gemma-3-12b-it:free\",\"qwen/qwen3-30b-a3b:free\",\"nvidia/llama-3.1-nemotron-ultra-253b-v1:free\",\"moonshotai/kimi-k2:free\"],\"secret\":\"OPENROUTER_API_KEY\"}]"
  }
}
